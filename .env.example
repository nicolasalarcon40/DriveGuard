# Copia este archivo a ".env" y ajusta según tu entorno.
#
# MODO LOCAL (por defecto): sin Docker, sin llamadas de red a AWS. S3 se
# simula como una carpeta en disco (data/local_aws/s3/...), DynamoDB como
# un JSON (data/local_aws/dynamodb/...) y SNS como un log de texto
# (data/local_aws/sns/risk-alerts.log). Ideal para desarrollar y para
# correr este repo en cualquier lado sin instalar nada más que Python.
#
# MODO AWS (con Docker + LocalStack en tu laptop, o en CI, o con una cuenta
# de AWS real): usa boto3 de verdad contra los recursos definidos en
# infra/ (Terraform) + docker-compose.yml.
DEPLOYMENT_MODE=local

# --- Solo se usan si DEPLOYMENT_MODE=aws ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=obd2-fleet-raw-trips
DYNAMODB_TABLE=obd2-fleet-driver-risk-current
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:obd2-fleet-risk-alerts

# --- Se usa en ambos modos: Postgres corre nativo/local siempre ---
DATABASE_URL=postgresql://obd2:obd2pass@localhost:5432/fleet_telemetry

RISK_ALERT_THRESHOLD=70
